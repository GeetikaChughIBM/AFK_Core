# ============================================================
# Software Factory — .gitignore
# ============================================================

# ── Secrets — NEVER commit ────────────────────────────────
config/secrets.env
*.env
!config/secrets.env.example

# ── Runtime state ─────────────────────────────────────────
db/
logs/
artifacts/

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Editor / OS ───────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc ──────────────────────────────────────────────────
*.log
*.jsonl
