# ============================================================
# Software Factory — Secrets Template
#
# Copy this file to config/secrets.env and fill in real values.
# config/secrets.env is git-ignored and NEVER committed.
# ============================================================

# ── Planner VM (worker-planner-01) ──────────────────────────
WORKER_PLANNER_01_SSH_PASSWORD=REPLACE_WITH_SSH_PASSWORD
WORKER_PLANNER_01_BOB_API_KEY=REPLACE_WITH_BOB_API_KEY_FOR_PLANNER

# ── Executor VM (worker-executor-01) ────────────────────────
WORKER_EXECUTOR_01_SSH_PASSWORD=REPLACE_WITH_SSH_PASSWORD
WORKER_EXECUTOR_01_BOB_API_KEY=REPLACE_WITH_BOB_API_KEY_FOR_EXECUTOR

# ── Orchestrator Git credentials (used by merge step) ───────
ORCHESTRATOR_GIT_TOKEN=REPLACE_WITH_GIT_PAT_OR_SSH_KEY_PATH
